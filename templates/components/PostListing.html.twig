{% props title, subtitle, excerpt, url, publishedAt, author %}

<article class="post">
    <header>
        <div class="title">
            <h2><a href="single.html">{{ title }}</a></h2>
            <p>{{ subtitle }}</p>
        </div>
        <div class="meta">
            <time class="published" datetime="2015-11-01">{{ publishedAt }}</time>
            <a href="#" class="author"><span class="name">{{ author }}</span><img src="assets/images/avatar.jpg" alt=""/></a>
        </div>
    </header>
    <a href="single.html" class="image featured"><img src="assets/images/sample_post.png" alt=""/></a>
    <p>{{ excerpt }}</p>
    <footer>
        <ul class="actions">
            <li><a href="{{ url }}" class="button large">Continue Reading</a></li>
        </ul>
        <ul class="stats">
            <li><a href="#">General</a></li>
            <li><a href="#" class="icon solid fa-heart">28</a></li>
            <li><a href="#" class="icon solid fa-comment">128</a></li>
        </ul>
    </footer>
</article>
