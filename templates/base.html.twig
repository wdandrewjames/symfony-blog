<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Symfony Blog{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        <link rel="stylesheet" href="/assets/css/main.css"/>
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
            <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
            <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
            <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>

    <body class="is-preload">

        <!-- Wrapper -->
        <div id="wrapper">

            <!-- Header -->
            <header id="header">
                <h1><a href="{{ path('home') }}">Symfony Blog Project</a></h1>
                <nav class="links">
                    <ul>
                        <li><a href="{{ path('home') }}">Posts</a></li>
                        <li><a href="#">About</a></li>
                        <li><a href="#">Tips</a></li>
                        <li><a href="#">Contact</a></li>
                    </ul>
                </nav>
                <nav class="main">
                    <ul>
                        <li class="search">
                            <a class="fa-search" href="#search">Search</a>
                            <form id="search" method="get" action="#">
                                <input type="text" name="query" placeholder="Search"/>
                            </form>
                        </li>
                        <li class="menu">
                            <a class="fa-bars" href="#menu">Menu</a>
                        </li>
                    </ul>
                </nav>
            </header>

            <!-- Menu -->
            <section id="menu">

                <!-- Search -->
                <section>
                    <form class="search" method="get" action="#">
                        <input type="text" name="query" placeholder="Search"/>
                    </form>
                </section>

                <!-- Links -->
                <section>
                    <ul class="links">
                        <li>
                            <a href="{{ path('home') }}">
                                <h3>Articles</h3>
                                <p>Notes from my Symfony learning journey</p>
                            </a>
                        </li>
                        <li>
                            <a href="#">
                                <h3>About</h3>
                                <p>Why I'm learning Symfony and building this blog</p>
                            </a>
                        </li>
                        <li>
                            <a href="#">
                                <h3>Tips</h3>
                                <p>Useful things I've learned along the way</p>
                            </a>
                        </li>
                        <li>
                            <a href="#">
                                <h3>Contact</h3>
                                <p>Questions, feedback, or just say hello</p>
                            </a>
                        </li>
                    </ul>
                </section>

                <!-- Actions -->
                <section>
                    <ul class="actions stacked">
                        <li><a href="#" class="button large fit">Log In</a></li>
                    </ul>
                </section>

            </section>

            <!-- Main -->
            <div id="main">
                {% block content %}{% endblock %}
            </div>

            <!-- Sidebar -->
            <section id="sidebar">

                <!-- Intro -->
                <section id="intro">
                    <a href="{{ path('home') }}" class="logo"><img src="/assets/images/logo.jpg" alt=""/></a>
                    <header>
                        <h2>Symfony Blog Project</h2>
                        <p>A project to learn Symfony PHP Framework</a></p>
                    </header>
                </section>

                <!-- Article List -->
                <section>
                    <ul class="posts">
                        {{ render(controller('App\\Controller\\Front\\RecentArticlesController')) }}
                    </ul>
                </section>

                <!-- About -->
                <twig:Blurb/>

                <!-- Footer -->
                <twig:Footer/>
            </section>

        </div>

        <!-- Scripts -->
        <script src="/assets/js/jquery.min.js"></script>
        <script src="/assets/js/browser.min.js"></script>
        <script src="/assets/js/breakpoints.min.js"></script>
        <script src="/assets/js/util.js"></script>
        <script src="/assets/js/main.js"></script>
    </body>
</html>
