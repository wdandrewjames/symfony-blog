{% extends 'base.html.twig' %}
{% block content %}

    <!-- Post -->
    <article class="post">
        <header>
            <div class="title">
                <h2>{{ article.title }}</h2>
                <p>{{ article.subtitle }}</p>
            </div>
            <div class="meta">
                <time class="published" datetime="2015-11-01">{{ article.publishedAt|date("M d, Y") }}</time>
                <a href="#" class="author"><span class="name">Andrew Rushton</span><img src="/assets/images/avatar.jpg" alt=""/></a>
            </div>
        </header>
        <span class="image featured"><img src="/assets/images/sample_post.png" alt=""/></span>
        <p>{{ article.content }}</p>
        <footer>
            <ul class="stats">
                <li><a href="#">General</a></li>
                <li><a href="#" class="icon solid fa-heart">28</a></li>
                <li><a href="#" class="icon solid fa-comment">128</a></li>
            </ul>
        </footer>
    </article>

{% endblock %}
